# ============================================================================
# THARAGA — Environment Variables
# Copy to .env.local for development, add to Netlify dashboard for production.
# Run GET /api/health/env-check after deploy to verify readiness.
# ============================================================================

# ─── CRITICAL (app won't start without these) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # Required for server-to-server automation calls

# ─── AI PROVIDER (at least one required for marketing content generation) ────
ANTHROPIC_API_KEY=sk-ant-...             # Primary — Claude claude-sonnet-4-6
GROQ_API_KEY=gsk_...                     # Free fallback — https://console.groq.com
# OPENAI_API_KEY=sk-...                  # Optional secondary fallback

# ─── META / FACEBOOK (required for social media posting) ─────────────────────
META_PAGE_ACCESS_TOKEN=EAAG...           # Meta Business Suite → Page → Access Tokens
META_WEBHOOK_VERIFY_TOKEN=random-secret  # Any random string; set same in Meta App config
META_APP_SECRET=abc123...               # App Secret from Meta for-developers.com

# ─── WHATSAPP / TWILIO (required for WhatsApp broadcast) ─────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886     # Twilio Sandbox or approved WhatsApp sender
TWILIO_PHONE_NUMBER_SID=PNxx...        # Optional: auto-configure chatbot webhook

# ─── EMAIL / RESEND (required for drip sequences and lead notifications) ──────
RESEND_API_KEY=re_...                   # https://resend.com — 3,000 emails/month free

# ─── PAYMENTS / RAZORPAY ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...            # Set in Razorpay dashboard → Webhooks

# ─── APP CONFIG ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tharaga.co.in       # Used for server-to-server internal calls
NEXT_PUBLIC_SITE_URL=https://tharaga.co.in      # Used for canonical URLs and SEO
CRON_SECRET=change-me-to-random-secret          # Protects /api/cron/* endpoints
INTERNAL_API_KEY=change-me-to-random-secret     # Protects inter-service workflow calls

# ─── ZOHO CRM (optional) ─────────────────────────────────────────────────────
# ZOHO_CLIENT_ID=...
# ZOHO_CLIENT_SECRET=...
# ZOHO_REDIRECT_URI=https://tharaga.co.in/api/crm/zoho/callback

# ─── ANALYTICS (optional) ────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
